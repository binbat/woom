{
  "name": "woom",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite -c webapp/vite.config.ts",
    "dev-refresh": "cross-env USE_REFRESH=true npm run dev",
    "lint": "eslint && vue-tsc --noEmit",
    "build": "npm run lint && vite build -c webapp/vite.config.ts",
    "build-refresh": "npm run lint && cross-env USE_REFRESH=true npm run build",
    "preview": "vite preview -c webapp/vite.config.ts",
    "test:e2e": "npm run build && cargo build --release && playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "copy-to-clipboard": "^3.3.3",
    "vue": "^3.5.40",
    "wavesurfer.js": "7.8.2",
    "whip-whep": "1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@iconify-json/logos": "^1.2.3",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin-js": "^2.10.1",
    "@types/node": "^22.9.0",
    "@unocss/preset-attributify": "^0.64.1",
    "@unocss/preset-icons": "^0.64.1",
    "@unocss/preset-uno": "^0.64.1",
    "@unocss/reset": "^0.64.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.10.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "unocss": "^0.64.1",
    "vite": "^5.4.11",
    "vue-tsc": "^3.3.9"
  }
}
