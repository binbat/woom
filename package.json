{
  "name": "woom",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite -c webapp/vite.config.ts",
    "dev-refresh": "cross-env USE_REFRESH=true npm run dev",
    "lint": "eslint && vue-tsc --noEmit",
    "build": "npm run lint && vite build -c webapp/vite.config.ts",
    "build-refresh": "npm run lint && cross-env USE_REFRESH=true npm run build",
    "preview": "vite preview -c webapp/vite.config.ts",
    "test:e2e": "npm run build && cargo build --release && playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "copy-to-clipboard": "^4.0.2",
    "vue": "^3.5.40",
    "wavesurfer.js": "^7.12.11",
    "whip-whep": "1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify-json/logos": "^1.2.3",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@types/node": "^26.1.2",
    "@unocss/preset-attributify": "^66.7.5",
    "@unocss/preset-icons": "^66.7.5",
    "@unocss/preset-uno": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.14.0",
    "unocss": "^66.7.5",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9"
  }
}
