{
  "name": "woom",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite -c webapp/vite.config.ts",
    "dev-refresh": "cross-env USE_REFRESH=true npm run dev",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint": "npm run check && eslint && vue-tsc --noEmit",
    "build": "npm run lint && vite build -c webapp/vite.config.ts",
    "build-refresh": "npm run lint && cross-env USE_REFRESH=true npm run build",
    "preview": "vite preview -c webapp/vite.config.ts",
    "test:rust": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test --all-targets",
    "test:e2e": "npm run build && cargo build --release --locked && playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "copy-to-clipboard": "^4.0.2",
    "vue": "^3.5.44",
    "whip-whep": "1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@eslint/js": "^10.0.1",
    "@iconify-json/logos": "^1.2.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@unocss/preset-attributify": "^66.7.5",
    "@unocss/preset-icons": "^66.7.5",
    "@unocss/preset-uno": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.14.0",
    "unocss": "^66.7.5",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9"
  }
}
